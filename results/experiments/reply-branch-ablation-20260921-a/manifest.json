{
  "cases": [
    {
      "id": "jsonl_base",
      "group": "jsonl",
      "phase": "base",
      "primary_file": "jsonl_base.py",
      "files": {
        "jsonl_base.py": ""
      },
      "prompt": "Create jsonl_base.py providing parse_jsonl(text). Return a list of decoded JSON values, in line order. Skip whitespace-only lines. Handle Unicode, CRLF and a final line without a newline. Malformed nonblank JSON lines must raise ValueError. No import-time I/O. Duplicate object keys follow standard json.loads behavior: the last value wins. Use only the standard library / built-in modules. Run small relevant checks before finishing. Do not install packages, use the network, or access files outside this workspace except your own temporary test files. Do not inspect external benchmark files. Finish with a short summary.",
      "check": "from jsonl_base import parse_jsonl\nassert parse_jsonl('  \\r\\n{\"x\":\"\u4e2d\u6587\"}\\r\\n[1,null]\\ntrue')==[{'x':'\u4e2d\u6587'},[1,None],True]\nassert parse_jsonl('')==[]\ntry:parse_jsonl('{bad}')\nexcept ValueError:pass\nelse:raise AssertionError('malformed JSON accepted')\nassert parse_jsonl('{\"x\":1,\"x\":2}')==[{\"x\":2}]\n"
    },
    {
      "id": "unique_repeat",
      "group": "unique",
      "phase": "repeat",
      "primary_file": "unique_repeat.mjs",
      "files": {
        "unique_repeat.mjs": ""
      },
      "prompt": "Create unique_repeat.mjs exporting named function uniqueStrings(values). Input is an array of strings. Return a new array retaining the first occurrence of each distinct string in original order, without mutating the input. Keep original spelling in output. Do not trim whitespace. Deduplication is case-sensitive; upper and lower case remain distinct. Use only the standard library / built-in modules. Run small relevant checks before finishing. Do not install packages, use the network, or access files outside this workspace except your own temporary test files. Do not inspect external benchmark files. Finish with a short summary.",
      "check": "import subprocess\np=subprocess.run([\"node\",\"--input-type=module\",\"-e\",'import assert from \\'node:assert/strict\\'; import {uniqueStrings} from \\'./unique_repeat.mjs\\';\\nconst input=[\\'A\\',\\'a\\',\\'A\\',\\' B \\',\\'b\\',\\'\u4e2d\u6587\\',\\'\u4e2d\u6587\\',\\'\\',\\'\\']; const copy=[...input];\\nconst result=uniqueStrings(input);assert.deepEqual(result,[\"A\", \"a\", \" B \", \"b\", \"\u4e2d\u6587\", \"\"]);\\nassert.deepEqual(input,copy);assert.notEqual(result,input);assert.deepEqual(uniqueStrings([]),[]);'],capture_output=True,text=True,timeout=5)\nassert p.returncode==0,p.stderr\n"
    },
    {
      "id": "edit_state_base",
      "group": "edit_state",
      "phase": "base",
      "primary_file": "service.json",
      "files": {
        "service.json": "{\"service\": {\"port\": 8080, \"label\": \"\u73b0\u6709\u914d\u7f6e\", \"features\": [\"a\", \"b\"]}, \"other\": {\"port\": 9000}, \"enabled\": true}"
      },
      "prompt": "Read service.json and change ONLY service.port to 8443. Preserve every other value, including unknown fields, Unicode strings, arrays and booleans. Do not create other deliverable files. Validate the resulting JSON. Use only the standard library / built-in modules. Run small relevant checks before finishing. Do not install packages, use the network, or access files outside this workspace except your own temporary test files. Do not inspect external benchmark files. Finish with a short summary.",
      "check": "from pathlib import Path\nimport json\nassert json.loads(Path(\"service.json\").read_text())=={'service': {'port': 8443, 'label': '\u73b0\u6709\u914d\u7f6e', 'features': ['a', 'b']}, 'other': {'port': 9000}, 'enabled': True}\n"
    },
    {
      "id": "nullable_changed",
      "group": "nullable_fresh",
      "phase": "fresh",
      "primary_file": "nullable_changed.sql",
      "files": {
        "nullable_changed.sql": ""
      },
      "prompt": "Create nullable_changed.sql containing only one SQLite SELECT query, no Markdown. Table readings has columns station TEXT and value INTEGER (nullable). Return station and total, where total is SUM(value) with all-NULL sums converted to 0. Group by station and order by station ascending. Exclude groups having no non-NULL values. Keep groups whose non-NULL values sum to zero or a negative number. Use only the standard library / built-in modules. Run small relevant checks before finishing. Do not install packages, use the network, or access files outside this workspace except your own temporary test files. Do not inspect external benchmark files. Finish with a short summary.",
      "check": "import sqlite3\nfrom pathlib import Path\nc=sqlite3.connect(':memory:');c.execute('CREATE TABLE readings(station TEXT,value INTEGER)')\nc.executemany('INSERT INTO readings VALUES (?,?)',[('a',1),('a',-1),('b',-2),('b',None),('c',None),('d',0),('e',7),('e',None)])\nsql=Path('nullable_changed.sql').read_text();assert c.execute(sql).fetchall()==[('a', 0), ('b', -2), ('d', 0), ('e', 7)]\nc.execute('DELETE FROM readings');assert c.execute(sql).fetchall()==[]\n"
    }
  ],
